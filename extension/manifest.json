{
  "manifest_version": 3,
  "name": "ClearNote — botless meeting notes",
  "version": "0.1.0",
  "description": "Captures Google Meet, Zoom and Teams transcripts from the platform's own captions. No bot joins your call.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.cloud.microsoft.com/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "ClearNote",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "ui/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/wc/*",
        "https://*.zoom.us/j/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.cloud.microsoft.com/*"
      ],
      "js": [
        "lib/util.js",
        "lib/segmenter.js",
        "lib/diagnostics.js",
        "platforms/meet.js",
        "platforms/zoom.js",
        "platforms/teams.js",
        "ui/sidebar.js",
        "content.js"
      ],
      "css": [
        "ui/sidebar.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "platforms/youtube.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/mark.svg"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.cloud.microsoft.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-audio": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Start or stop recording the meeting's audio"
    }
  }
}
